NEXT_PUBLIC_SITE_URL=https://www.estherduartenutri.com.br
NEXT_PUBLIC_WHATSAPP_NUMBER=5562993526881
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/estherduarte_nutri/
# Google Business Profile: link "Compartilhar" do Google Maps (entra no JSON-LD como sameAs). Vazio = fora.
NEXT_PUBLIC_GOOGLE_BUSINESS_URL=
# Google Search Console: só o token da meta google-site-verification. Vazio = sem a tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Medição (só carrega após o aceite de cookies). Vazio = desligado.
# GTM (GTM-XXXXXXX): quando preenchido, GA4 e Pixel podem ser gerenciados pelo contêiner; o GA_ID direto continua opcional.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
